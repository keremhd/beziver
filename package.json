{
  "devDependencies": {
    "esbuild": "0.24.0",
    "http-server": "^14.1.1"
  },
  "dependencies": {
    "genetic-js": "^0.1.14"
  },
  "scripts": {
    "build": "esbuild src/app.js --bundle --outfile=public/script.js",
    "watch": "esbuild src/app.js --bundle --outfile=public/script.js --watch",
    "serve": "esbuild src/app.js --sourcemap=inline --bundle --outfile=public/script.js --servedir=public/",
    "run": "npx http-server -o"
  }
}
